@page "/profile"
@using ChancePr3TRBlazor.ApiRequest
@using ChancePr3TRBlazor.ApiRequest.Models
@using ChancePr3TRBlazor.ApiRequest.Services
@inject UserService UserService
@inject ChatService ChatService
@inject NavigationManager Navigation


<PageTitle>Profile</PageTitle>

<body>
    <nav aria-label="Основная навигация" class="profile-style-001">
        <div class="static-header profile-style-002">
            <NavLink href="/" class="" @onmouseenter="() => _isHover = true" @onmouseleave="() => _isHover = false">
                <div class="profile-style-003">
                    <img src="@(_isHover ? "chance-gif.gif" : "chance.png")" class="profile-style-004" alt="Chance logo"/>
                    <span class="profile-style-006">Шанс</span>
                </div>
            </NavLink>
            <div class="hidden-mobile profile-style-007">
                <NavLink href="/" class="static-page-link profile-style-008">Главная</NavLink>
                <NavLink href="/tracker" class="static-page-link profile-style-008">Настроение</NavLink>
                <NavLink href="/chat" class="static-page-link profile-style-008">Чат</NavLink>
                <NavLink href="/specials" class="static-page-link profile-style-008">Специалисты</NavLink>
                <NavLink href="/profile" class="static-page-link profile-style-009" aria-current="page" Match="NavLinkMatch.All">Профиль</NavLink>
                <NavLink href="/about" class="static-page-link profile-style-008">О сервисе</NavLink>
            </div>
            <div class="profile-style-010">
                <NavLink href="/crisis" class="static-page-link profile-style-011">🆘 Срочная помощь</NavLink>
                <details class="mobile-menu">
                    <summary aria-label="Меню">
                        <div class="profile-style-012"></div>
                        <div class="profile-style-012"></div>
                        <div class="profile-style-013"></div>
                    </summary>
                    <div class="mobile-menu-links">
                        <NavLink href="/">Главная</NavLink>
                        <NavLink href="/tracker">Трекер настроения</NavLink>
                        <NavLink href="/chat">Анонимный чат</NavLink>
                        <NavLink href="/specials">База специалистов</NavLink>
                        <NavLink href="/profile" aria-current="page" Match="NavLinkMatch.All">Мой профиль</NavLink>
                        <NavLink href="/crisis">Кризисная помощь</NavLink>
                        <NavLink href="/about">О сервисе</NavLink>
                    </div>
                </details>
            </div>
        </div>
    </nav>
    <main>
        <div class="profile-style-014">
            <h1 class="profile-style-015">Мой профиль</h1>
            <div class="profile-style-016">
                <div class="profile-style-017">
                    <div class="profile-style-018">
                        <div class="profile-style-019">А</div>
                        <div>
                            <div class="profile-style-020"><p>@userDataShort.fullname</p></div>
                            <div class="profile-style-021"><p>@userDataShort.college</p></div>
                            <div class="profile-style-022"><p>@userDataShort.email</p></div>
                        </div>
                    </div>
                    <button type="button" class="profile-style-023">✏️ Редактировать профиль</button>
                </div>
                <div class="profile-style-017">
                    <h3 class="profile-style-024">Статистика</h3>
                    <div class="profile-style-025">
                        <div class="profile-style-026">
                            <span class="profile-style-027">📊</span>
                            <div class="profile-style-028">
                                <div class="profile-style-029">Записей настроения</div>
                                <div class="profile-style-006">@moods.Count</div>
                            </div>
                        </div>
                        <div class="profile-style-026">
                            <span class="profile-style-027">📅</span>
                            <div class="profile-style-028">
                                <div class="profile-style-029">Дней в приложении</div>
                                <div class="profile-style-006">31</div>
                            </div>
                        </div>
                        <div class="profile-style-026">
                            <span class="profile-style-027">⭐</span>
                            <div class="profile-style-028">
                                <div class="profile-style-029">Средний балл</div>
                                <div class="profile-style-006">@avarageMood</div>
                            </div>
                        </div>
                    </div>
                    <NavLink href="/tracker" class="static-page-link profile-style-030">Открыть трекер</NavLink>
                </div>
                <div class="profile-style-017">
                    <h3 class="profile-style-031">Последние записи настроения</h3>
                    <div class="profile-style-032">
                        @if (moods.Count == 0)
                        {
                            <h3 class="profile-style-031">Нет записей</h3>
                        }
                        else
                        {
                            int rowCount = 0;
                            foreach (var mood in moods.OrderByDescending(m => m.createdAt))
                            {
                                if (rowCount >= 5) break;
                                string levelSmile = "";
                                switch (mood.moodLevel)
                                {
                                    case 5:
                                        levelSmile = "😄 Отлично";
                                        break;
                                    case 4:
                                        levelSmile = "🙂 Хорошо";
                                        break;
                                    case 3:
                                        levelSmile = "😐 Нейтрально";
                                        break;
                                    case 2:
                                        levelSmile = "😔 Плохо";
                                        break;
                                    case 1:
                                        levelSmile = "😢 Ужасно";
                                        break;
                                }
                                rowCount++;

                                <div class="profile-style-033">
                                    <span class="profile-style-027">@levelSmile.Split(' ').First()</span>
                                    <span class="profile-style-034">@levelSmile.Split(' ').Last()</span>
                                    <span class="profile-style-029">@mood.createdAt.ToString("d MMM")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="profile-style-017">
                    <h3 class="profile-style-024">Настройки</h3>
                    <div class="profile-style-045">
                        <button type="button" class="profile-style-046" @onclick="Exit_Click">Выйти из аккаунта</button>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>

