@code {
    private bool _isHover;
    private string avarageMood = "";
    private List<MoodDataShort> moods = new();
    private UserDataShort userDataShort = new();
    [Inject] private RequestApi _requestApi { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (UserService.CurrentUser == null)
            {
                Navigation.NavigateTo("auth");
                return;
            }

            await GetProfileData();
            await GetAllMoods();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task GetProfileData()
    {
        try
        {
            if (UserService.CurrentUser == null) return;

            string userToken = UserService.CurrentUser.token ?? "";

            var response = await _requestApi.CheckProfileAsync(userToken);

            Console.WriteLine($"Статус запроса: {response.status}");
            if (response.status == false) return;

            userDataShort = response.data;

            Console.WriteLine($"id: {userDataShort.userId}, email: {userDataShort.email}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task GetAllMoods()
    {
        try
        {
            var moodsData = await _requestApi.GetMoodAsync();
            moods = moodsData.data.moods ?? new List<MoodDataShort>();
            moods = moods.Where(m => m.userId == UserService.CurrentUser.userId).ToList();

            CalculateStats();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void CalculateStats()
    {
        try
        {
            avarageMood = $"{moods.Sum(m => m.moodLevel) / moods.Count} 🙂";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void Exit_Click()
    {
        try
        {
            UserService.ClearUser();

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}