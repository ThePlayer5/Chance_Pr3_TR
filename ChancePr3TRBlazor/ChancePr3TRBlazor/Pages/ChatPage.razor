@code {
    private bool _isHover;

    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (DocService.CurrentDoc == null || UserService.CurrentUser == null)
            {
                Navigation.NavigateTo("specials");
                return;
            }

            ChatService.OnChatUsersUpdate = StateHasChanged;
            ChatService.OnMessageReceived = StateHasChanged;

            await ChatService.Connect();
            await AddNewChatUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task AddNewChatUser()
    {
        try
        {
            if (UserService.CurrentUser == null) return;
            if (DocService.CurrentDoc == null) return;

            await ChatService.AddChatUser(UserService.CurrentUser.userId, DocService.CurrentDoc.doctorId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task AddMessage()
    {
        try
        {
            if (ChatService.IsUserActive == false) return;
            if (UserService.CurrentUser == null) return;
            if (DocService.CurrentDoc == null) return;

            if (string.IsNullOrEmpty(message)) return;

            await ChatService.SendMessage(DocService.CurrentDoc.doctorId, UserService.CurrentUser.userId, message);

            message = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ExitChat_Click()
    {
        try
        {
            ChatService.ChatUsers.Clear();
            ChatService.Messages.Clear();
            Navigation.NavigateTo("specials");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

}
