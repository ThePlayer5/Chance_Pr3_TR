<PageTitle>Specialists</PageTitle>

<body>
    <nav aria-label="Основная навигация" class="specialists-style-001">
        <div class="static-header specialists-style-002">
            <NavLink href="/" class="" @onmouseenter="() => _isHover = true" @onmouseleave="() => _isHover = false">
                <div class="specialists-style-003">
                    <img src="@(_isHover ? "chance-gif.gif" : "chance.png")" class="specialists-style-004" alt="Chance logo"/>
