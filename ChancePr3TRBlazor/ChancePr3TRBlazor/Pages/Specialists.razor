                </div>
            </NavLink>
            <div class="hidden-mobile specialists-style-007">
                <NavLink href="/" class="static-page-link specialists-style-008">Главная</NavLink>
                <NavLink href="/tracker" class="static-page-link specialists-style-008">Настроение</NavLink>
                <NavLink href="/chat" class="static-page-link specialists-style-008">Чат</NavLink>
                <NavLink href="/specials" class="static-page-link specialists-style-009" aria-current="page" Match="NavLinkMatch.All">Специалисты</NavLink>
                <NavLink href="/profile" class="static-page-link specialists-style-008">Профиль</NavLink>
                <NavLink href="/about" class="static-page-link specialists-style-008">О сервисе</NavLink>
            </div>
            <div class="specialists-style-010">
                <NavLink href="/crisis" class="static-page-link specialists-style-011">🆘 Срочная помощь</NavLink>
                <details class="mobile-menu">
                    <summary aria-label="Меню">
                        <div class="specialists-style-012"></div>
                        <div class="specialists-style-012"></div>
                        <div class="specialists-style-013"></div>
                    </summary>
                    <div class="mobile-menu-links">
                        <NavLink href="/">Главная</NavLink>
                        <NavLink href="/tracker">Трекер настроения</NavLink>
                        <NavLink href="/chat">Анонимный чат</NavLink>
                        <NavLink href="/specials" aria-current="page" Match="NavLinkMatch.All">База специалистов</NavLink>
                        <NavLink href="/profile">Мой профиль</NavLink>
                        <NavLink href="/crisis">Кризисная помощь</NavLink>
                        <NavLink href="/about">О сервисе</NavLink>
                    </div>
                </details>
            </div>
        </div>
    </nav>
    <main>
        <div class="specialists-style-014">
            <h1 class="specialists-style-015">База специалистов</h1>
            <p class="specialists-style-016">Психологи, психотерапевты и организации, готовые помочь студентам.</p>
            <div class="specialists-style-017">
                <input placeholder="🔍  Поиск по имени, описанию или ключевым словам" aria-label="🔍  Поиск по имени, описанию или ключевым словам" class="specialists-style-018"
                        @bind:event="oninput" @bind:after="OnSearchChanged" @bind="search">
            </div>
            <div class="specialists-style-019">
                <button type="button" class="specialists-style-021" @onclick="() => FilterDocsList(0)">Все</button>
                <button type="button" class="specialists-style-021" @onclick="() => FilterDocsList(1)">Тревога и стресс</button>
                <button type="button" class="specialists-style-021" @onclick="() => FilterDocsList(2)">Депрессия</button>
                <button type="button" class="specialists-style-021" @onclick="() => FilterDocsList(3)">Межличностные отношения</button>
                <button type="button" class="specialists-style-021" @onclick="() => FilterDocsList(4)">Кризисная помощь</button>
                <button type="button" class="specialists-style-021" @onclick="() => FilterDocsList(5)">Учёба и концентрация</button>
            </div>
            <div class="specialists-style-022">
                @if (docs.Count == 0)
                {
                    <h3 class="specialists-style-015">Специалистов нет</h3>
                }
                else
                {
                    foreach (var doc in filteredDocs)
                    {
                        <div class="specialists-style-023" @onclick="() => OpenDocChat(doc)">
                            <div class="specialists-style-024">
                                <div class="specialists-style-025">👤</div>
                                <div class="specialists-style-026">
                                    <div class="specialists-style-027">@doc.fullname</div>
                                    <div class="specialists-style-028">@doc.special</div>
                                    <div class="specialists-style-029">@doc.workplace</div>
                                </div>
                                <span class="specialists-style-030">● Онлайн</span>
                            </div>
                            <p class="specialists-style-031">Специализируется на работе со студентами: тревожность, экзаменационный стресс...</p>
                            <button type="button" class="specialists-style-032">Подробнее</button>
                            <div class="specialists-style-033">
                                <span class="specialists-style-034">Тревога</span>
                                <span class="specialists-style-034">Стресс</span>
                                <span class="specialists-style-034">Адаптация</span>
                            </div>
                            <div class="specialists-style-035">
                                <a href="tel:+7 (495) 939-10-82" class="specialists-style-036">
                                    📞
                                    <span class="specialists-style-037">+ @doc.phone</span>
                                </a>
                                <a href="mailto:belova@psyhelp.msu.ru" class="specialists-style-038">✉️ @doc.email</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </main>
