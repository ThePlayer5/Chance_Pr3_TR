@code {
    private bool _isHover;
    private string search = "";
    private List<DocDataShort> docs = new();
    private List<DocDataShort> filteredDocs = new();
    [Inject] private RequestApi _requestApi { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await GetAllDocs();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task GetAllDocs()
    {
        try
        {
            var docsData = await _requestApi.GetDoctorsAsync();
            docs = docsData.data.docs ?? new List<DocDataShort>();
            filteredDocs = docs;

            Console.WriteLine($"Статус запроса: {docsData.status}");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task FilterDocsList(int parametr)
    {
        try
        {
            switch (parametr)
            {
                case 1:
                    filteredDocs = docs.ToList();
                    return;
                case 2:
                    filteredDocs = docs.Where(d => d.userId == 2).ToList();
                    return;
                case 3:
                    filteredDocs = new();
                    return;
                case 4:
                    filteredDocs = new();
                    return;
                case 5:
                    filteredDocs = docs.Where(d => d.userId == 3).ToList();
                    return;
                default:
                    filteredDocs = docs.ToList();
                    return;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task OnSearchChanged()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(search))
            filteredDocs = docs.Where(d => d.fullname == search).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task OpenDocChat(DocDataShort doctor)
    {
        try
        {
            if (doctor == null) return;

            var newDoc = new Doctor
            {
                doctorId = doctor.doctorId,
                fullname = doctor.fullname,
                email = doctor.email
            };
            DocService.SetDoc(newDoc);

            Navigation.NavigateTo("chat");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

}
