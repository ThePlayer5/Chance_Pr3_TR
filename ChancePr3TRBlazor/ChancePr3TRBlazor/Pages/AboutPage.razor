@page "/about"
@using ChancePr3TRBlazor.ApiRequest.Services
@inject UserService UserService

<PageTitle>About</PageTitle>

<body>
    <nav aria-label="Основная навигация" class="about-style-001">
        <div class="static-header about-style-002">
            <NavLink href="/" class="" @onmouseenter="() => _isHover = true" @onmouseleave="() => _isHover = false">
                <div class="about-style-003">
                    <img src="@(_isHover ? "chance-gif.gif" : "/chance.png")" class="about-style-004" alt="Chance logo"/>
                    <span class="about-style-006">Шанс</span>
                </div>
            </NavLink>
            <div class="hidden-mobile about-style-007">
                <NavLink href="/" class="static-page-link about-style-008">Главная</NavLink>
                <NavLink href="/tracker" class="static-page-link about-style-008">Настроение</NavLink>
                <NavLink href="/chat" class="static-page-link about-style-008">Чат</NavLink>
                <NavLink href="/specials" class="static-page-link about-style-008">Специалисты</NavLink>
                <NavLink href="/profile" class="static-page-link about-style-008">Профиль</NavLink>
                <NavLink href="/about" class="static-page-link about-style-009" aria-current="page" Match="NavLinkMatch.All">О сервисе</NavLink>
            </div>
            <div class="about-style-010">
                <NavLink href="/crisis" class="static-page-link about-style-011">🆘 Срочная помощь</NavLink>
                <details class="mobile-menu">
                    <summary aria-label="Меню">
                        <div class="about-style-012"></div>
                        <div class="about-style-012"></div>
                        <div class="about-style-013"></div>
                    </summary>
                    <div class="mobile-menu-links">
                        <NavLink href="/">Главная</NavLink>
                        <NavLink href="/tracker">Трекер настроения</NavLink>
                        <NavLink href="/chat">Анонимный чат</NavLink>
                        <NavLink href="/specials">База специалистов</NavLink>
                        <NavLink href="/profile">Мой профиль</NavLink>
                        <NavLink href="/crisis">Кризисная помощь</NavLink>
                        <NavLink href="/about" aria-current="page" Match="NavLinkMatch.All">О сервисе</NavLink>
                    </div>
                </details>
            </div>
        </div>
    </nav>
    <main>
        <div class="about-style-014">
            <div class="about-style-015">
                <img src="/chance-gif.gif" class="about-style-016" alt="Chance logo" />
                <h1 class="about-style-018">О сервисе «Шанс»</h1>
                <p class="about-style-019">Платформа психологической поддержки, созданная специально для студентов. Безопасно, бесплатно и без осуждения.</p>
            </div>
            <div class="about-style-020">
                <h2 class="about-style-021">Наша миссия</h2>
                <p class="about-style-022">Сделать психологическую поддержку доступной для каждого студента. Мы верим, что своевременная помощь меняет жизни — и хотим, чтобы любой человек мог её получить в любой момент, не стесняясь и не откладывая.</p>
            </div>
            <div class="about-style-023">
                <h2 class="about-style-024">Проблема, которую мы решаем</h2>
                <div class="about-style-025">
                    <div class="about-style-026">
                        <span class="about-style-027">✕</span>
                        <span class="about-style-028">Студенты часто не знают, куда обратиться за помощью</span>
                    </div>
                    <div class="about-style-026">
                        <span class="about-style-027">✕</span>
                        <span class="about-style-028">Стигма вокруг психологических проблем мешает просить о поддержке</span>
                    </div>
                    <div class="about-style-026">
                        <span class="about-style-027">✕</span>
                        <span class="about-style-028">Доступных и понятных ресурсов для молодёжи крайне мало</span>
                    </div>
                    <div class="about-style-026">
                        <span class="about-style-027">✕</span>
                        <span class="about-style-028">Кризисные ситуации требуют немедленного реагирования</span>
                    </div>
                </div>
            </div>
            <h2 class="about-style-024">Основные возможности</h2>
            <div class="about-style-029">
                <div class="about-style-030">
                    <div class="about-style-031">📊</div>
                    <h3 class="about-style-032">Трекер настроения</h3>
                    <p class="about-style-033">Ежедневные отметки помогают отследить динамику и понять, что влияет на ваше состояние.</p>
                </div>
                <div class="about-style-030">
                    <div class="about-style-031">💬</div>
                    <h3 class="about-style-032">Анонимный чат</h3>
                    <p class="about-style-033">Поговорите со специалистом поддержки без регистрации и раскрытия личных данных.</p>
                </div>
                <div class="about-style-030">
                    <div class="about-style-031">👥</div>
                    <h3 class="about-style-032">База специалистов</h3>
                    <p class="about-style-033">Актуальный список психологов и кризисных центров с контактами и описанием.</p>
                </div>
                <div class="about-style-030">
                    <div class="about-style-031">🆘</div>
                    <h3 class="about-style-032">Кризисная помощь</h3>
                    <p class="about-style-033">Горячие линии и пошаговые действия всегда под рукой — для экстренных ситуаций.</p>
                </div>
            </div>
            <div class="about-style-034">
                <h2 class="about-style-035">Наши принципы</h2>
                <div class="about-style-036">
                    <div class="about-style-037">
                        <span class="about-style-038">✓</span>
                        Конфиденциальность — ваши данные под защитой
                    </div>
                    <div class="about-style-037">
                        <span class="about-style-038">✓</span>
                        Анонимность — никто не знает, кто вы
                    </div>
                    <div class="about-style-037">
                        <span class="about-style-038">✓</span>
                        Доступность — бесплатно для всех студентов
                    </div>
                    <div class="about-style-037">
                        <span class="about-style-038">✓</span>
                        Без осуждения — каждый достоин помощи
                    </div>
                </div>
            </div>
            <div class="about-style-039">
                <NavLink href="/" class="static-page-link about-style-040">На главную</NavLink>
                <NavLink href="/crisis" class="static-page-link about-style-041">🆘 Кризисная помощь</NavLink>
            </div>
        </div>
    </main>
</body>

