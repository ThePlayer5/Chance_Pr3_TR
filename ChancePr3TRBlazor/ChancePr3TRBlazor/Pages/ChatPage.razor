@page "/chat"
@using ChancePr3TRBlazor.ApiRequest.Services
@inject UserService UserService
@inject DocService DocService
@inject ChatService ChatService
@inject NavigationManager Navigation

<PageTitle>Chat</PageTitle>

<body>
    <nav aria-label="Основная навигация" class="chat-style-001">
        <div class="static-header chat-style-002">
            <NavLink href="/" class="" @onmouseenter="() => _isHover = true" @onmouseleave="() => _isHover = false">
                <div class="chat-style-003">
                    <img src="@(_isHover ? "chance-gif.gif" : "chance.png")" class="chat-style-004" alt="Chance logo"/>
                    <span class="chat-style-006">Шанс</span>
                </div>
            </NavLink>
            <div class="hidden-mobile chat-style-007">
                <NavLink href="/" class="static-page-link chat-style-008">Главная</NavLink>
                <NavLink href="/tracker" class="static-page-link chat-style-008">Настроение</NavLink>
                <NavLink href="/chat" class="static-page-link chat-style-009" aria-current="page" Match="NavLinkMatch.All">Чат</NavLink>
                <NavLink href="/specials" class="static-page-link chat-style-008">Специалисты</NavLink>
                <NavLink href="/profile" class="static-page-link chat-style-008">Профиль</NavLink>
                <NavLink href="/about" class="static-page-link chat-style-008">О сервисе</NavLink>
            </div>
            <div class="chat-style-010">
                <NavLink href="/crisis" class="static-page-link chat-style-011">🆘 Срочная помощь</NavLink>
                <details class="mobile-menu">
                    <summary aria-label="Меню">
                        <div class="chat-style-012"></div>
                        <div class="chat-style-012"></div>
                        <div class="chat-style-013"></div>
                    </summary>
                    <div class="mobile-menu-links">
                        <NavLink href="/">Главная</NavLink>
                        <NavLink href="/tracker">Трекер настроения</NavLink>
                        <NavLink href="/chat" aria-current="page" Match="NavLinkMatch.All">Анонимный чат</NavLink>
                        <NavLink href="/specials">База специалистов</NavLink>
                        <NavLink href="/profile">Мой профиль</NavLink>
                        <NavLink href="/crisis">Кризисная помощь</NavLink>
                        <NavLink href="/about">О сервисе</NavLink>
                    </div>
                </details>
            </div>
        </div>
    </nav>
    <main>
        <div class="chat-style-014">
            <div class="chat-style-015">
                <div class="chat-style-010">
                    <div class="chat-style-016">💬</div>
                    <div>
                        <div class="chat-style-017">
                            @(DocService.CurrentDoc == null ? "Анонимный пользователь" : DocService.CurrentDoc.fullname)
                        </div>
                        <div class="chat-style-018">
                            <div class="chat-style-019"></div>
                            <span class="chat-style-020">Онлайн</span>
                        </div>
                    </div>
                </div>
                <div class="chat-style-021">
                    <button type="button" class="chat-style-022" @onclick="ExitChat_Click">Завершить</button>
                </div>
            </div>
            <div class="chat-style-023">
                @if (ChatService.Messages.Count <= 0 && ChatService.Messages != null)
                {
                    <p class="chat-style-026">Сообщения отсутствуют!</p>
                }
                else
                {
                    foreach (var message in ChatService.Messages)
                    {
                        <div class="chat-style-024">
                            <div class="chat-style-025">
                                <p class="chat-style-026">@message.Text</p>
                                <p class="chat-style-027">@message.SendTime.ToString("d MMM yy HH:mm")</p>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="chat-style-028">
                <textarea placeholder="Напишите сообщение... (Enter для отправки)" rows="2" aria-label="Напишите сообщение... (Enter для отправки)" class="chat-style-029" @bind="message"></textarea>
                <button type="button" class="chat-style-030" @onclick="AddMessage">➤</button>
            </div>
            <p class="chat-style-031">Имя указывать не нужно. Всё анонимно и конфиденциально.</p>
        </div>
    </main>
</body>

<style>
